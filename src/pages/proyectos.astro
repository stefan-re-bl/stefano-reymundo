---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Proyectos" description="Proyectos y trabajos explicados desde el problema, las restricciones y las decisiones tomadas." canonicalPath="/proyectos/">
  <h1 class="page-title">Proyectos</h1>
  <p class="page-description">Una selección sobria de trabajos. Estos ejemplos son placeholders para reemplazar con proyectos reales.</p>

  <section class="project-list" aria-label="Proyectos">
    <article class="project">
      <h2>Proyecto de ejemplo: sistema operativo interno</h2>
      <p>Placeholder para describir un sistema construido para ordenar operaciones reales de un negocio.</p>
      <dl>
        <div>
          <dt>Problema</dt>
          <dd>Procesos dispersos, decisiones manuales y poca visibilidad del estado del trabajo.</dd>
        </div>
        <div>
          <dt>Decisiones</dt>
          <dd>Modelo simple, flujo claro y automatización solo donde reducía trabajo repetitivo.</dd>
        </div>
        <div>
          <dt>Tecnologías</dt>
          <dd>Reemplazar con stack real.</dd>
        </div>
      </dl>
    </article>

    <article class="project">
      <h2>Proyecto de ejemplo: automatización de reporting</h2>
      <p>Placeholder para un trabajo enfocado en ahorrar tiempo y reducir errores en informes periódicos.</p>
      <dl>
        <div>
          <dt>Restricciones</dt>
          <dd>Datos existentes, usuarios no técnicos y necesidad de mantenimiento bajo.</dd>
        </div>
        <div>
          <dt>Participación</dt>
          <dd>Definición del flujo, implementación y documentación para operación posterior.</dd>
        </div>
        <div>
          <dt>Aprendizajes</dt>
          <dd>Reemplazar con aprendizajes reales del proyecto.</dd>
        </div>
      </dl>
    </article>
  </section>
</BaseLayout>

---
import { site } from '@/config';
import { withBase } from '@/utils';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = site.name,
  description = site.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonical = new URL(withBase(canonicalPath), Astro.site ?? Astro.url);
const rssUrl = new URL(withBase('/rss.xml'), Astro.site ?? Astro.url);
const sitemapUrl = new URL(withBase('/sitemap-index.xml'), Astro.site ?? Astro.url);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const storedTheme = (() => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        })();
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : prefersDark
            ? 'dark'
            : 'light';

        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Archivo:wght@700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title={`RSS de ${site.name}`} href={rssUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-title" href={withBase('/')}>{site.name}</a>
        <div class="site-header__actions">
          <nav class="site-nav" aria-label="Principal">
            {site.nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
          </nav>
          <button class="theme-toggle" type="button" aria-label="Cambiar a modo oscuro" aria-pressed="false" data-theme-toggle>
            <span class="theme-toggle__track" aria-hidden="true">
              <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.5 14.3A7.2 7.2 0 0 1 9.7 3.5a8.8 8.8 0 1 0 10.8 10.8Z"></path>
              </svg>
              <span class="theme-toggle__knob"></span>
            </span>
          </button>
        </div>
      </div>
    </header>
    <main class="site-main">
      <div class="site-shell">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="site-shell">
        <p>&copy; {new Date().getFullYear()} {site.name}. Escrito y mantenido con Astro, Markdown y Git.</p>
      </div>
    </footer>
    <script>
      const storageKey = 'theme';
      const toggle = document.querySelector('[data-theme-toggle]');

      function setTheme(theme: string | undefined) {
        const nextTheme = theme === 'dark' ? 'dark' : 'light';

        document.documentElement.dataset.theme = nextTheme;

        try {
          localStorage.setItem(storageKey, nextTheme);
        } catch {
          // Theme switching still works for the current page when storage is unavailable.
        }

        if (toggle instanceof HTMLButtonElement) {
          const isDark = nextTheme === 'dark';
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
        }

      }

      if (toggle instanceof HTMLButtonElement) {
        setTheme(document.documentElement.dataset.theme);
        toggle.addEventListener('click', () => {
          setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
        });
      }
    </script>
  </body>
</html>
